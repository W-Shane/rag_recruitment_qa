# .env.example
# 阿里云通义（烧钱）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
QWEN_LLM_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Embedding（本地）
EMBEDDING_MODEL=./models/text2vec-base-chinese

# 向量库路径
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=recruit_job

# 数据路径
DATA_PATH=data/job.csv

# 检索返回条数
TOP_K=5

# 混合检索权重（BM25 + 向量，两者相加建议=1.0）
VECTOR_WEIGHT=0.7
BM25_WEIGHT=0.3

# 日志
LOG_LEVEL=INFO
LOG_DIR=./logs

# 超时与重试（调用大模型 API 时使用）
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=3